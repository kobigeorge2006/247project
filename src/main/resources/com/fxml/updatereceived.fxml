<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@styles.css"
            prefWidth="1280"
            prefHeight="960"
            styleClass="app-root">
    <left>
        <VBox styleClass="sidebar"
              spacing="20"
              minWidth="224"
              prefWidth="224"
              maxWidth="224">
            <Label text="CHH"
                   styleClass="design-label, text-30-semibold-white"
                   wrapText="true"
                   alignment="TOP_LEFT"
                   textOverrun="CLIP"
                   minHeight="44"
                   prefHeight="44"
                   maxHeight="44"/>

            <Label text="Carolina&#10;Hurricane Helper"
                   styleClass="design-label, text-15-semibold-white"
                   wrapText="true"
                   alignment="TOP_LEFT"
                   textOverrun="CLIP"
                   minWidth="176"
                   prefWidth="176"
                   maxWidth="176"
                   minHeight="44"
                   prefHeight="44"
                   maxHeight="44"/>

            <VBox spacing="6"
                  minWidth="176"
                  prefWidth="176"
                  maxWidth="176"
                  minHeight="400"
                  prefHeight="400"
                  maxHeight="400">
                <Label text="FIND SUPPORT"
                       styleClass="design-label, text-10-semibold-99ACC8"
                       wrapText="true"
                       alignment="TOP_LEFT"
                       textOverrun="CLIP"
                       minHeight="15"
                       prefHeight="15"
                       maxHeight="15"/>

                <Button text="Home"
                        userData="Home"
                        styleClass="nav-button"
                        minWidth="176"
                        prefWidth="176"
                        maxWidth="176"
                        minHeight="46"
                        prefHeight="46"
                        maxHeight="46"/>

                <Button text="Find shelter"
                        userData="Nearby shelters"
                        styleClass="nav-button"
                        minWidth="176"
                        prefWidth="176"
                        maxWidth="176"
                        minHeight="46"
                        prefHeight="46"
                        maxHeight="46"/>

                <Button text="Storm updates"
                        userData="Storm updates"
                        styleClass="nav-button"
                        minWidth="176"
                        prefWidth="176"
                        maxWidth="176"
                        minHeight="46"
                        prefHeight="46"
                        maxHeight="46"/>

                <Label text="VOLUNTEER"
                       styleClass="design-label, text-10-semibold-99ACC8"
                       wrapText="true"
                       alignment="TOP_LEFT"
                       textOverrun="CLIP"
                       minHeight="15"
                       prefHeight="15"
                       maxHeight="15"/>

                <Button text="Browse requests"
                        userData="Browse requests"
                        styleClass="nav-button"
                        minWidth="176"
                        prefWidth="176"
                        maxWidth="176"
                        minHeight="46"
                        prefHeight="46"
                        maxHeight="46"/>

                <Button text="My requests"
                        userData="My requests"
                        styleClass="nav-button, nav-button-selected"
                        minWidth="176"
                        prefWidth="176"
                        maxWidth="176"
                        minHeight="46"
                        prefHeight="46"
                        maxHeight="46"/>

                <Button text="Volunteer program"
                        userData="Volunteer application"
                        styleClass="nav-button"
                        minWidth="176"
                        prefWidth="176"
                        maxWidth="176"
                        minHeight="46"
                        prefHeight="46"
                        maxHeight="46"/>
            </VBox>

            <Region minHeight="0"
                    VBox.vgrow="ALWAYS"/>

            <VBox spacing="8"
                  styleClass="account-box, panel-1C2943-12-8-plain"
                  minWidth="176"
                  prefWidth="176"
                  maxWidth="176"
                  minHeight="95"
                  prefHeight="95"
                  maxHeight="95">
                <Label text="YOUR ACCOUNT"
                       styleClass="design-label, text-10-semibold-caption"
                       wrapText="true"
                       alignment="TOP_LEFT"
                       textOverrun="CLIP"
                       minHeight="15"
                       prefHeight="15"
                       maxHeight="15"/>

                <Hyperlink text="Sign in / Register"
                           userData="Sign in"
                           styleClass="text-link"/>
            </VBox>

            <Label text="Help starts with&#10;our community."
                   styleClass="design-label, text-13-regular-caption"
                   wrapText="true"
                   alignment="TOP_LEFT"
                   textOverrun="CLIP"
                   minWidth="176"
                   prefWidth="176"
                   maxWidth="176"
                   minHeight="38"
                   prefHeight="38"
                   maxHeight="38"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="AS_NEEDED"
                    styleClass="page-scroll">
            <content>
                <VBox spacing="24"
                      minWidth="1056"
                      prefWidth="1056"
                      minHeight="960"
                      styleClass="main-content">
                    <Label text="CAROLINA HURRICANE HELPER  /  UPDATE RECEIVED"
                           styleClass="design-label, text-11-semibold-muted"
                           wrapText="true"
                           alignment="TOP_LEFT"
