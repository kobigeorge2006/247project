                           prefWidth="976"
                           maxWidth="976"
                           minHeight="46"
                           prefHeight="46"
                           maxHeight="46"/>

                    <Label text="Prototype confirmation; no JSON record was changed."
                           styleClass="design-label, text-16-regular-muted"
                           wrapText="true"
                           alignment="TOP_LEFT"
                           textOverrun="CLIP"
                           minWidth="976"
                           prefWidth="976"
                           maxWidth="976"
                           minHeight="24"
                           prefHeight="24"
                           maxHeight="24"/>

                    <VBox spacing="6"
                          styleClass="panel-yellow-20-12-plain"
                          minWidth="976"
                          prefWidth="976"
                          maxWidth="976"
                          minHeight="100"
                          prefHeight="100"
                          maxHeight="100">
                        <Label text="Current recorded status: ASSIGNED"
                               styleClass="design-label, text-16-semibold-navy"
                               wrapText="true"
                               alignment="TOP_LEFT"
                               textOverrun="CLIP"
                               minWidth="936"
                               prefWidth="936"
                               maxWidth="936"
                               minHeight="24"
                               prefHeight="24"
                               maxHeight="24"/>

                        <Label text="Update history, review status and email notifications were not supplied."
                               styleClass="design-label, text-14-regular-muted"
                               wrapText="true"
                               alignment="TOP_LEFT"
                               textOverrun="CLIP"
                               minWidth="936"
                               prefWidth="936"
                               maxWidth="936"
                               minHeight="21"
                               prefHeight="21"
                               maxHeight="21"/>
                    </VBox>

                    <VBox spacing="16"
                          styleClass="panel-white-24-12-plain"
                          minWidth="976"
                          prefWidth="976"
                          maxWidth="976"
                          minHeight="180"
                          prefHeight="180"
                          maxHeight="180">
                        <Label text="Keep track of your request"
                               styleClass="design-label, text-21-semibold-navy"
                               wrapText="true"
                               alignment="TOP_LEFT"
                               textOverrun="CLIP"
                               minWidth="928"
                               prefWidth="928"
                               maxWidth="928"
                               minHeight="31"
                               prefHeight="31"
                               maxHeight="31"/>

                        <Label text="You can return to My requests to view the current status."
                               styleClass="design-label, text-15-regular-muted"
                               wrapText="true"
                               alignment="TOP_LEFT"
                               textOverrun="CLIP"
                               minWidth="928"
                               prefWidth="928"
                               maxWidth="928"
                               minHeight="22"
                               prefHeight="22"
                               maxHeight="22"/>
                    </VBox>

                    <Button text="Back to my requests"
                            userData="My requests"
                            styleClass="primary-button"
                            minHeight="46"
                            prefHeight="46"
                            maxHeight="46"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
