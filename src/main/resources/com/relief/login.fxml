<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.LoginController"
            prefWidth="1280.0"
            prefHeight="960.0"
            style="-fx-background-color: #F4F6F9; -fx-font-family: 'System';">

    <!-- LEFT NAVIGATION -->
    <left>
        <VBox prefWidth="224.0"
              minWidth="224.0"
              maxWidth="224.0"
              spacing="20.0"
              style="-fx-background-color: #10182C;">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label text="CHH"
                   style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>

            <Label text="Carolina&#10;Hurricane Helper"
                   style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <VBox spacing="6.0">
                <Label text="FIND SUPPORT"
                       style="-fx-text-fill: #99ACC8; -fx-font-size: 10px; -fx-font-weight: bold;"/>

                <Button text="Home"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="Find shelter"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="Storm updates"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Label text="VOLUNTEER"
                       style="-fx-text-fill: #99ACC8; -fx-font-size: 10px; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets top="12"/>
                    </VBox.margin>
                </Label>

                <Button text="Browse requests"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="My requests"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="Volunteer program"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8"
                  minHeight="95"
                  prefHeight="95"
                  style="-fx-background-color: #1C2943; -fx-background-radius: 8;">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>

                <Label text="YOUR ACCOUNT"
                       style="-fx-text-fill: #A6B4D0; -fx-font-size: 10px; -fx-font-weight: bold;"/>

                <Label text="Sign in / Register"
                       style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </VBox>

            <Label text="Help starts with&#10;our community."
                   style="-fx-text-fill: #A6B4D0; -fx-font-size: 13px;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F4F6F9; -fx-background-color: #F4F6F9; -fx-padding: 0;">

            <content>
                <VBox spacing="24"
                      style="-fx-background-color: #F4F6F9;">
                    <padding>
                        <Insets top="40" right="40" bottom="40" left="40"/>
                    </padding>

                    <Label text="CAROLINA HURRICANE HELPER  /  SIGN IN"
                           style="-fx-text-fill: #637084; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <Label text="Sign in"
                           style="-fx-text-fill: #10182C; -fx-font-size: 32px; -fx-font-weight: bold;"/>

                    <Label text="Welcome back. Sign in to manage your relief requests."
                           wrapText="true"
                           style="-fx-text-fill: #637084; -fx-font-size: 16px;"/>

                    <!-- LOGIN CARD -->
                    <VBox prefWidth="540"
                          maxWidth="540"
                          minHeight="460"
                          spacing="16"
                          style="-fx-background-color: white; -fx-background-radius: 12;">

                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>

                        <Label text="Welcome back"
                               style="-fx-text-fill: #10182C; -fx-font-size: 24px; -fx-font-weight: bold;"/>

                        <VBox spacing="8">
                            <Label text="Email or username"
                                   labelFor="$txt_username"
                                   style="-fx-text-fill: #10182C; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                            <TextField fx:id="txt_username"
                                       promptText="Enter your email or username"
                                       prefHeight="48"
                                       maxWidth="470"
                                       style="-fx-background-color: #F4F6F9; -fx-background-radius: 8; -fx-border-color: #DDE3EB; -fx-border-radius: 8; -fx-padding: 12 14; -fx-font-size: 14px; -fx-text-fill: #10182C; -fx-prompt-text-fill: #637084;"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Password"
                                   labelFor="$txt_password"
                                   style="-fx-text-fill: #10182C; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                            <PasswordField fx:id="txt_password"
                                           promptText="Enter your password"
                                           prefHeight="48"
                                           maxWidth="470"
                                           onAction="#handleLogin"
                                           style="-fx-background-color: #F4F6F9; -fx-background-radius: 8; -fx-border-color: #DDE3EB; -fx-border-radius: 8; -fx-padding: 12 14; -fx-font-size: 14px; -fx-text-fill: #10182C; -fx-prompt-text-fill: #637084;"/>
                        </VBox>

                        <Hyperlink text="Forgot password?"
                                   style="-fx-text-fill: #243E80; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0; -fx-border-color: transparent;"/>

                        <Button text="Sign in"
                                onAction="#handleLogin"
                                defaultButton="true"
                                minHeight="46"
                                style="-fx-background-color: #10182C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand;"/>

                        <Hyperlink text="New here? Create an account"
                                   style="-fx-text-fill: #243E80; -fx-font-size: 14px; -fx-padding: 0; -fx-border-color: transparent;"/>

                        <Label fx:id="statusLabel"
                               wrapText="true"
                               maxWidth="470"
                               style="-fx-text-fill: #B42318; -fx-font-size: 13px;"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>