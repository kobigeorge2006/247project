<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.ReliefScreensController"
            prefWidth="1100" prefHeight="800"
            stylesheets="@relief-screens.css">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="24" styleClass="page">

                    <Label text="CAROLINA HURRICANE HELPER / APPLICATION RECEIVED"
                           styleClass="breadcrumb"/>

                    <Label text="Application received"
                           styleClass="page-title"/>

                    <Label text="Prototype application confirmation."
                           styleClass="body-copy"/>

                    <VBox spacing="10" styleClass="notice">
                        <Label text="Review status not provided"
                               styleClass="card-title"/>

                        <Label text="No application review timeframe is included in the supplied data."
                               wrapText="true"
                               styleClass="body-copy"/>
                    </VBox>

                    <VBox spacing="14" styleClass="card">
                        <Label text="What to expect"
                               styleClass="card-title"/>

                        <Label text="This preview keeps your application fields for this run only. It does not send an application or record an approval."
                               wrapText="true"
                               styleClass="body-copy"/>
                    </VBox>

                    <Button text="Return to overview"
                            userData="volunteerapplication"
                            onAction="#navigate"
                            styleClass="primary"/>

                    <Button text="View existing volunteer record"
                            userData="welcometotheteam"
                            onAction="#navigate"
                            styleClass="text-link"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>