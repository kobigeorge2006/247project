<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.ReliefScreensController"
            prefWidth="1100" prefHeight="800"
            stylesheets="@relief-screens.css">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="24" styleClass="page">

                    <Label text="CAROLINA HURRICANE HELPER / UPDATE RECEIVED"
                           styleClass="breadcrumb"/>

                    <Label text="Update received"
                           styleClass="page-title"/>

                    <Label text="Prototype confirmation; no JSON record was changed."
                           wrapText="true" styleClass="body-copy"/>

                    <VBox spacing="10" styleClass="notice">

                        <Label fx:id="currentStatusLabel"
                               text="Current preview status: ASSIGNED"
                               styleClass="card-title"/>

                        <Label text="Your preview update is kept for this run only. No email notification was sent."
                               wrapText="true"
                               styleClass="body-copy"/>

                    </VBox>

                    <VBox spacing="14" styleClass="card">

                        <Label text="Keep track of your request"
                               styleClass="card-title"/>

                        <Label fx:id="updatedMessageLabel"
                               wrapText="true"
                               styleClass="body-copy"/>

                    </VBox>

                    <Button text="Back to my requests"
                            userData="my-requests"
                            onAction="#navigate"
                            styleClass="primary"/>

                    <Button text="View or edit preview update"
                            userData="updaterequest"
                            onAction="#navigate"
                            styleClass="text-link"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>