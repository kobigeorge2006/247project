<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.HomeController"
            prefWidth="1280"
            prefHeight="960"
            style="-fx-background-color: #F4F6F9; -fx-font-family: 'System';">

    <!-- SIDEBAR -->
    <left>
        <VBox minWidth="224"
              prefWidth="224"
              maxWidth="224"
              spacing="20"
              style="-fx-background-color: #10182C;">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label text="CHH"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Carolina&#10;Hurricane Helper"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <VBox spacing="6">
                <Label text="FIND SUPPORT"
                       style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #99ACC8;"/>

                <Button text="Home"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: #FFFBD9; -fx-background-radius: 8; -fx-text-fill: #10182C; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="Find shelter"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="Storm updates"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Label text="VOLUNTEER"
                       style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #99ACC8;">
                    <VBox.margin>
                        <Insets top="12"/>
                    </VBox.margin>
                </Label>

                <Button text="Browse requests"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="My requests"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>

                <Button text="Volunteer program"
                        maxWidth="Infinity"
                        prefHeight="46"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D4DDEE; -fx-font-size: 14px; -fx-padding: 0 12; -fx-cursor: hand;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8"
                  minHeight="95"
                  style="-fx-background-color: #1C2943; -fx-background-radius: 8;">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>

                <Label text="YOUR ACCOUNT"
                       style="-fx-text-fill: #A6B4D0; -fx-font-size: 10px; -fx-font-weight: bold;"/>

                <Button text="My account"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0; -fx-cursor: hand;"/>
            </VBox>

            <Label text="Help starts with&#10;our community."
                   style="-fx-text-fill: #A6B4D0; -fx-font-size: 13px;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #F4F6F9; -fx-background-color: #F4F6F9; -fx-padding: 0;">

            <content>
                <VBox spacing="24">
                    <padding>
                        <Insets top="40" right="40" bottom="40" left="40"/>
                    </padding>

                    <Label text="CAROLINA HURRICANE HELPER  /  HOME"
                           style="-fx-text-fill: #637084; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <Label text="How can we help today?"
                           wrapText="true"
                           style="-fx-text-fill: #10182C; -fx-font-size: 32px; -fx-font-weight: bold;"/>

                    <Label text="Find support, coordinate requests, and help your community recover."
                           wrapText="true"
                           style="-fx-text-fill: #637084; -fx-font-size: 16px;"/>

                    <!-- STORM NOTICE -->
                    <VBox spacing="8"
                          style="-fx-background-color: #FFFBD9; -fx-background-radius: 12;">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Storm information"
                               style="-fx-text-fill: #10182C; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <Label text="Check the latest official advisories before planning travel or assistance."
                               wrapText="true"
                               style="-fx-text-fill: #637084; -fx-font-size: 14px;"/>
                    </VBox>

                    <!-- FOUR MAIN ACTIONS -->
                    <GridPane hgap="24" vgap="24">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="0"
                              spacing="16"
                              minWidth="0"
                              minHeight="200"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #DDE3EB; -fx-border-radius: 12;">
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>

                            <Label text="Find a shelter"
                                   wrapText="true"
                                   style="-fx-text-fill: #10182C; -fx-font-size: 21px; -fx-font-weight: bold;"/>

                            <Label text="Browse shelter locations, status and capacity."
                                   wrapText="true"
                                   style="-fx-text-fill: #637084; -fx-font-size: 15px;"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Find shelters"
                                    wrapText="true"
                                    onAction="#goToShelters"
                                    style="-fx-background-color: #10182C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="0"
                              spacing="16"
                              minWidth="0"
                              minHeight="200"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #DDE3EB; -fx-border-radius: 12;">
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>

                            <Label text="Request help"
                                   wrapText="true"
                                   style="-fx-text-fill: #10182C; -fx-font-size: 21px; -fx-font-weight: bold;"/>

                            <Label text="Tell the team what your household needs."
                                   wrapText="true"
                                   style="-fx-text-fill: #637084; -fx-font-size: 15px;"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Request assistance"
                                    wrapText="true"
                                    style="-fx-background-color: #10182C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="1"
                              spacing="16"
                              minWidth="0"
                              minHeight="200"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #DDE3EB; -fx-border-radius: 12;">
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>

                            <Label text="Help your neighbors"
                                   wrapText="true"
                                   style="-fx-text-fill: #10182C; -fx-font-size: 21px; -fx-font-weight: bold;"/>

                            <Label text="Browse requests and coordinate your next visit."
                                   wrapText="true"
                                   style="-fx-text-fill: #637084; -fx-font-size: 15px;"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Browse requests"
                                    wrapText="true"
                                    style="-fx-background-color: #10182C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="1"
                              spacing="16"
                              minWidth="0"
                              minHeight="200"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #DDE3EB; -fx-border-radius: 12;">
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>

                            <Label text="Become a volunteer"
                                   wrapText="true"
                                   style="-fx-text-fill: #10182C; -fx-font-size: 21px; -fx-font-weight: bold;"/>

                            <Label text="Create a profile and offer help."
                                   wrapText="true"
                                   style="-fx-text-fill: #637084; -fx-font-size: 15px;"/>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Button text="Join the program"
                                    wrapText="true"
                                    style="-fx-background-color: #10182C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand;"/>
                        </VBox>
                    </GridPane>

                    <!-- REQUEST TRACKING -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #DDE3EB; -fx-border-radius: 12;">
                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>

                        <Label text="Already asked for help?"
                               wrapText="true"
                               style="-fx-text-fill: #10182C; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <Label text="Check your request status and see the next steps."
                               wrapText="true"
                               style="-fx-text-fill: #637084; -fx-font-size: 15px;"/>

                        <Button text="Track my requests"
                                style="-fx-background-color: #10182C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand;"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>